# Required in production. Demo workspace stays public-read without it.
ANYKPI_API_KEY=

# Required to persist connector credentials (encrypted at rest).
ANYKPI_SECRET=

# Optional. SQLite file path (default: ./data/anykpi.db)
# DATABASE_PATH=

# Postgres is not supported yet. See docs/introduction.md#postgres-later

# Optional. Origin used in API view_url values.
# When unset, the origin is taken from Host / X-Forwarded-*.
# Do not use NEXT_PUBLIC_BASE_URL — it is inlined at build time.
# PUBLIC_BASE_URL=

# Deprecated read-only fallback for the shipped connectors.
# Prefer /connect or `anykpi connect` (encrypted at rest).
# POSTHOG_API_KEY=
# POSTHOG_PROJECT_ID=
# POSTHOG_HOST=

# MIXPANEL_PROJECT_ID=
# MIXPANEL_API_SECRET=

# AMPLITUDE_API_KEY=
# AMPLITUDE_SECRET_KEY=

# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=

# REVENUECAT_API_KEY=
# REVENUECAT_PROJECT_ID=

# Optional. BYO model for cluster *name* refinement only.
# Default clustering is local and makes zero network calls.
# Both must be set to opt in. Person ids/names/emails are never sent.
# ANYKPI_CLUSTER_MODEL_KEY=
# ANYKPI_CLUSTER_MODEL_URL=
