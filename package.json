{
  "name": "anykpi",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @anykpi/sdk build && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "sdk:build": "pnpm --filter @anykpi/sdk build",
    "sdk:consumer-types": "tsx scripts/check-sdk-consumer.ts",
    "db:init": "tsx scripts/init-db.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate:pg": "drizzle-kit generate --config drizzle.config.pg.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:seed": "tsx src/demo/seed.ts",
    "readme:assets": "tsx scripts/capture-readme-assets.ts",
    "cli": "pnpm --filter @anykpi/cli exec node dist/index.js",
    "cli:build": "pnpm --filter @anykpi/cli build",
    "anykpi": "pnpm --filter @anykpi/cli exec node dist/index.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@tanstack/react-query": "^5.59.0",
    "better-sqlite3": "^11.8.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.7",
    "nanoid": "^5.0.9",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.49.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.33.3"
}
